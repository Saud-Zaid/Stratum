#!/usr/bin/env bash
# vault-python — the single entry point for running AI-Agent/scripts reliably across macOS and Linux.
#
# Resolves VAULT, the Python interpreter (preferring the vault's .venv), PYTHONPATH extensions, and
# the offline tiktoken cache directory without overwriting caller-supplied environment variables:
#
#   VAULT              $VAULT, else the vault root containing this wrapper (AI-Agent/..)
#   PYTHONPATH         caller's PYTHONPATH plus optional library folders ($VAULT_PYLIB, $VAULT/AI-Agent/pylib, /opt/pylib)
#   TIKTOKEN_CACHE_DIR $TIKTOKEN_CACHE_DIR, else ${XDG_CACHE_HOME:-$HOME/.cache}/tiktoken
#
# Usage: AI-Agent/vault-python AI-Agent/scripts/state.py [args]
#        AI-Agent/vault-python --env
set -eu

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do self="$(readlink "$self")"; done
here="$(cd "$(dirname "$self")" && pwd)"
VAULT="${VAULT:-$(cd "$here/.." && pwd)}"
export VAULT

pylibs=""
for cand in "${VAULT_PYLIB:-}" "$VAULT/AI-Agent/pylib" "/opt/pylib"; do
  if [ -n "$cand" ] && [ -d "$cand" ]; then
    if [ -z "$pylibs" ]; then pylibs="$cand"; else pylibs="$pylibs:$cand"; fi
  fi
done
if [ -n "$pylibs" ]; then
  PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$pylibs"
  export PYTHONPATH
fi

export TIKTOKEN_CACHE_DIR="${TIKTOKEN_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/tiktoken}"

if [ -n "${VAULT_PYTHON:-}" ]; then
  py="$VAULT_PYTHON"
elif [ -x "$VAULT/.venv/bin/python" ]; then
  py="$VAULT/.venv/bin/python"
elif command -v python3.13 >/dev/null 2>&1; then
  py="$(command -v python3.13)"
elif command -v uv >/dev/null 2>&1 && uv_py="$(uv python find 3.13 2>/dev/null || true)" && [ -n "$uv_py" ] && [ -x "$uv_py" ]; then
  py="$uv_py"
else
  py="python3"
fi

if [ "$py" != "$VAULT/.venv/bin/python" ] && [ -z "${PYTHONPATH:-}" ] && [ -z "$pylibs" ]; then
  echo "vault-python: no .venv or pinned library folder found — run ./setup.sh first." >&2
fi

# Lock stamp: setup writes sha256(uv.lock) to .venv/.stratum-lock-sha256. Warn once if stale when using .venv.
if [ "$py" = "$VAULT/.venv/bin/python" ] && [ -f "$VAULT/uv.lock" ] && [ -f "$VAULT/.venv/.stratum-lock-sha256" ]; then
  if command -v sha256sum >/dev/null 2>&1; then want="$(sha256sum "$VAULT/uv.lock" | cut -d' ' -f1)"; else want="$(shasum -a 256 "$VAULT/uv.lock" | cut -d' ' -f1)"; fi
  have="$(tr -d '[:space:]' < "$VAULT/.venv/.stratum-lock-sha256")"
  if [ "$want" != "$have" ]; then
    echo "vault-python: .venv is older than uv.lock — run ./setup.sh to refresh it." >&2
  fi
fi

if [ "${1:-}" = "--env" ]; then
  printf 'python="%s"\nVAULT="%s"\nPYTHONPATH="%s"\nTIKTOKEN_CACHE_DIR="%s"\n' "$py" "$VAULT" "${PYTHONPATH:-}" "$TIKTOKEN_CACHE_DIR"
  exit 0
fi

exec "$py" "$@"
